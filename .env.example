# ============================================================
# Variables de entorno requeridas
# Copia este archivo como .env y rellena los valores
# NUNCA subas el .env real al repositorio
# ============================================================

# ── LLMs ─────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Opcional (Gemini)

# ── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Webhook (solo en producción) ──────────────────────────────
# En desarrollo local dejar vacío → modo polling automático
# En Render.com: URL de tu servicio (sin / al final)
WEBHOOK_URL=https://rag-transito-bot.onrender.com
PORT=8443

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_MODE=local   # "local" o "http"
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Re-Ranking ────────────────────────────────────────────────
# false por defecto (demasiado lento en CPU sin GPU)
RERANKER_ENABLED=false
